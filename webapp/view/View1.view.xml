<mvc:View controllerName="modulo.proyectoprueba.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m" 
    xmlns:l="sap.ui.layout">
    
    <Page id="page">
        <ObjectHeader id="objHdrId01" title="{i18n>title}" backgroundDesign="Solid">
            <attributes>
				<ObjectAttribute id="objAttrId01" title="Estado" text="{i18n>subtitle}" />
			</attributes>
        </ObjectHeader>
        <Panel id="pnId01" width="100%">
            <FlexBox id='flboxId01' direction="Column" alignItems="Center">
                <Button
                    id="btnId01"
			        text="Click y saludo"
			        class="sapUiLargeMarginBottom"
			        press=".onAlertMessageBoxPress"
			        width="220px" 
                />
                <Label id="lblId01" text="Ingresá tu nombre" labelFor="input-name" />
		        <Input id="input-name" liveChange=".onInputChange" placeholder="Escribir..." />
                <Button
                    id="btnId02"
			        text="Ingresar"
			        class="sapUiLargeMarginBottom"
			        press=".onShowGreeting"
			        width="170px" 
                    enabled="{viewModel>/isButtonEnabled}"
                />
                <Button id="btnId03"
                    text="Obtener productos"
                    press=".onFetchProducts"
                />

                <Table id="idProductsTable" items="{productsModel>/products}" width="100%">
                    <headerToolbar>
                        <Toolbar id="toolBar">
                            <Title id="title" text="Lista de Productos" />
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="column01">
                            <Text id="text01" text="ID de Categoria" />
                        </Column>
                        <Column id="column02">
                            <Text id="text02" text="Nombre del Producto" />
                        </Column>
                        <Column id="column03">
                            <Text id="text03" text="Precio" />
                        </Column>
                        <Column id="column04">
                            <Text id="text04" text="Stock" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="listItem">
                            <cells>
                                <Text id="detail01" text="{productsModel>CategoryID}" />
                                <Text id="detail02" text="{productsModel>ProductName}" />
                                <Text id="detail03" text="{productsModel>UnitPrice}" />
                                <Text id="detail04" text="{productsModel>UnitsInStock}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </FlexBox>
        </Panel>
    </Page>
</mvc:View>