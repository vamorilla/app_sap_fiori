<mvc:View controllerName="modulo.proyectoprueba.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:c="sap.ui.core"
    xmlns="sap.m" 
    xmlns:l="sap.ui.layout">
    
    <Page id="page">
        <ObjectHeader id="objHdrId01" title="{i18n>title}" backgroundDesign="Solid">
            <attributes>
				<ObjectAttribute id="objAttrId01" title="Estado" text="{i18n>subtitle}" />
			</attributes>
        </ObjectHeader>
        <Panel id="pnId01" width="100%">
            <FlexBox id='flboxId01' direction="Column" alignItems="Center">
                <Button
                    id="btnId01"
			        text="{i18n>buttonGreeting}"
			        class="sapUiLargeMarginBottom"
			        press=".onAlertMessageBoxPress"
			        width="220px" 
                />
                <Label id="lblId01" text="{i18n>labelPersonalGreeting}" labelFor="input-name" />
		        <Input id="input-name" liveChange=".onInputChange" placeholder="{i18n>placeholderPersonalGreeting}" />
                <Button
                    id="btnId02"
			        text="{i18n>buttonPersonalGreeting}"
			        class="sapUiLargeMarginBottom"
			        press=".onShowGreeting"
			        width="170px" 
                    enabled="{viewModel>/isButtonEnabled}"
                />
                <ObjectHeader
                    title="{i18n>tableTitle}"
                />
                <FlexBox id="idSearchContainer" direction="Row" alignItems="Center" justifyContent="Start" width="100%" class="sapUiLargeMarginBottom">
                    <l:VerticalLayout
		            width="100%">
                        <Label text="Nombre"/>
                        <Input id="idSearchInput"
                            placeholder="{i18n>placeholderSearchProduct}"
                            value="{CategoriesProductModel>/valueInputSearch}">
                            <layoutData>
                                <FlexItemData growFactor="1" />
                            </layoutData>
                        </Input>
                    </l:VerticalLayout>
                    <l:VerticalLayout
		                width="100%">
                        <Label text="Categoría"/>
                        <ComboBox
                            selectedKey="{CategoriesProductModel>/selectedKey}"
                            selectionChange=".onSelectionChange"
				            items="{
					            path: '/Categories',
					            sorter: { path: 'CategoryName' }
				            }">
				                <c:Item key="{CategoryID}" text="{CategoryName}" />
			            </ComboBox>
                    </l:VerticalLayout>
                    <l:VerticalLayout
		                width="100%">
                        <Label text="Proveedores"/>
                        <MultiComboBox
                            selectedKeys="{CategoriesProductModel>/selectedSuppliers}"
			                maxWidth="650px"
			                items="{
				                path: '/Suppliers',
				                sorter: { path: 'SupplierID' }
			                }">
			                <c:Item key="{SupplierID}" text="{SupplierID}" />
		                </MultiComboBox>
                    </l:VerticalLayout>
                    <l:VerticalLayout
		                width="100%">
                        <Label text="Proveedores (multi input)"/>
                        <MultiInput width="70%"
			                showClearIcon="true"
			                id="multiInput"
			                suggestionItems="{
				                path: '/Suppliers',
				                sorter: { path: 'CompanyName' }
			                }"
                            suggestionItemSelected=".onSupplierSelected"
			                showValueHelp="false">
			                <c:Item key="{SupplierID}" text="{CompanyName}" />
		                </MultiInput>
                    </l:VerticalLayout>    
                     <Button id="idSearchButton" text="{i18n>buttonSearchText}" press=".onFetchProducts" width="auto" />
                </FlexBox>
                <c:Fragment
                    fragmentName='modulo.proyectoprueba.view.fragments.ProductsTable'
                    type="XML"
                />    
            </FlexBox>
        </Panel>
    </Page>
</mvc:View>